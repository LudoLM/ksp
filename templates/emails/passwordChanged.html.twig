<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Mot de passe modifié</title>
</head>
<body>
<div class="body">
    <div class="container">
        <div class="header text-center">
        </div>
        <div class="content">
            <p class="text-center">Bonjour {{ user.prenom }}!</p>
            <p class="block">
                Votre mot de passe a été modifié avec succès le {{ changedAt|date('d/m/Y à H:i') }}.
            </p>
            <p class="block">
                <strong>Si vous n'êtes pas à l'origine de ce changement</strong>,
                veuillez nous contacter immédiatement à *****.
            </p>
            <p>
                Cordialement,<br><br>
                L'équipe Kiné Sport Santé
            </p>
        </div>
    </div>
</div>
</body>
</html>
